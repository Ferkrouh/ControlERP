# ==============================================================================
# Variables de Entorno de Producción para ControlERP (Servidor Ubuntu Linux)
# Copia este archivo como .env en el servidor: cp .env.production.example .env
# ==============================================================================

# Entorno
NODE_ENV=production
PORT=3000
HOSTNAME="0.0.0.0"
NEXT_PUBLIC_APP_NAME="ControlERP"

# Secreto criptográfico para tokens JWT de sesión (Generar con: openssl rand -hex 32)
JWT_SECRET="controlerp_super_secret_jwt_key_cambiar_en_produccion_xyz123"

# Credenciales de Base de Datos PostgreSQL
POSTGRES_USER=controlerp
POSTGRES_PASSWORD=controlerp_secure_password_2026!
POSTGRES_DB=controlerp_db
POSTGRES_PORT=5432

# Cadena de conexión interna de Docker para Prisma
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# Túnel Cloudflare Zero Trust (Acceso mundial por HTTPS sin abrir puertos en router)
# Obtén tu token gratuito en https://dash.cloudflare.com/ -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=""

# Parámetros para script de respaldos automáticos
BACKUP_DIR="/opt/controlerp/backups"
RETENTION_DAYS=30
